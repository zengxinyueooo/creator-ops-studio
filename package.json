{
  "name": "creator-ops-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-opencli-xhs-upload.mjs",
    "dev": "node scripts/start-dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:agent": "concurrently -k -n web,worker -c cyan,magenta \"pnpm dev:web\" \"pnpm worker\"",
    "worker": "tsx agent/worker.ts",
    "worker:research": "pnpm worker",
    "worker:once": "tsx agent/worker.ts --once",
    "check:worker": "tsc -p tsconfig.agent.json",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "opencli:doctor": "opencli doctor",
    "opencli:xhs": "opencli xiaohongshu"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@supabase/supabase-js": "^2.112.4",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "typebox": "^1.3.28"
  },
  "devDependencies": {
    "@jackwener/opencli": "^1.8.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
